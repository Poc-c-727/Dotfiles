#== Basic Start-up (auto start) stuff ==
    # default font for sway
        font pango:OpenDyslexicMono 8

    exec noctalia
#=========================

#== Monitors ==
    # `swaymsg -t get_outputs` for monitor details
    output eDP-1 resolution 1366x768 position 0,0
#================


#== Noctalia config ==
    set $ipc noctalia msg

    # Core Binds
        bindsym $mod+space exec $ipc panel-toggle launcher
        bindsym $mod+s exec $ipc panel-toggle control-center
        bindsym $mod+comma exec $ipc settings-toggle

    # Media
        bindsym --locked XF86AudioRaiseVolume exec $ipc volume-up
        bindsym --locked XF86AudioLowerVolume exec $ipc volume-down
        bindsym --locked XF86AudioMute exec $ipc volume-mute
        bindsym --locked XF86MonBrightnessUp exec $ipc brightness-up
        bindsym --locked XF86MonBrightnessDown exec $ipc brightness-down
#============


#== Mod Keys & App Variables ==
    set $mod Super
    set $left h
    set $down j
    set $up k
    set $right l
    set $term kitty
    set $file_explorer dolphin
    set $web_browser helium

    set $test_app_launcher rofi -show drun

#================================


#== Basic Keybinds ==
    bindsym $mod+Return exec $term
    bindsym $mod+BackSpace exec $web_browser
    bindsym $mod+e exec $file_explorer
    bindsym $mod+Shift+d $test_app_launcher
    bindsym $mod+q kill
    bindsym $mod+Shift+c reload
    bindsym $mod+Shift+space floating toggle

    floating_modifier $mod normal

    # Exit sway (logs you out of your Wayland session)
        bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
#======================


#== Windows Bindings ==
    bindsym $mod+f fullscreen

    # Move focus
        bindsym $mod+$left focus left
        bindsym $mod+$down focus down
        bindsym $mod+$up focus up
        bindsym $mod+$right focus right

        # For Arrow Keys:
        bindsym $mod+Left focus left
        bindsym $mod+Down focus down
        bindsym $mod+Up focus up
        bindsym $mod+Right focus right

    # Change Focused Windows Position
        bindsym $mod+Alt+$left move left
        bindsym $mod+Alt+$down move down
        bindsym $mod+Alt+$up move up
        bindsym $mod+Alt+$right move right

        # For Arrow Keys:
        bindsym $mod+Alt+Left move left
        bindsym $mod+Alt+Down move down
        bindsym $mod+Alt+Up move up
        bindsym $mod+Alt+Right move right
